class Estudiante:
    def __init__(self, id_est, nombre, apellido, calificaciones):
        self.id = id_est
        self.nombre = nombre
        self.apellido = apellido
        self.calificaciones = calificaciones
        self.siguiente = None

class GestionEstudiantes:
    def __init__(self):
        self.cabeza = None

    def inscribir(self, id_est, nombre, apellido, calificaciones):
        nuevo = Estudiante(id_est, nombre, apellido, calificaciones)
        nuevo.siguiente = self.cabeza
        self.cabeza = nuevo

    def dar_de_baja(self, id_est):
        actual = self.cabeza
        anterior = None
        while actual:
            if actual.id == id_est:
                if anterior:
                    anterior.siguiente = actual.siguiente
                else:
                    self.cabeza = actual.siguiente
                return True
            anterior = actual
            actual = actual.siguiente
        return False

    def buscar(self, id_est):
        actual = self.cabeza
        while actual:
            if actual.id == id_est:
                return actual
            actual = actual.siguiente
        return None
